{
  "name": "clothesline-desktop",
  "version": "0.1.4",
  "description": "晒衣绳 — Windows 桌面截图工具",
  "main": "src/main.js",
  "author": "Clothesline contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "icons": "node scripts/make-icons.js",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.clothesline.desktop",
    "productName": "Clothesline",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "icon": "src/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Clothesline-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Clothesline-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": { "artifactName": "Clothesline-Portable-${version}-${arch}.${ext}" }
  }
}
